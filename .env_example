# Copy this file to .env and fill in the values.

# Public base URL of the site, used for sitemap, robots.txt, llms.txt and metadata.
NEXT_PUBLIC_BASE_URL=https://wiki.tutla.net

# GitHub token for GitHub sync. Optional for public repos (raises the rate limit
# from 60 to 5000 requests/hour), required for private repos.
# Fine-grained token with Contents: Read-only on the synced repos.
GITHUB_TOKEN=

# Secret for the /api/revalidate endpoint that refreshes GitHub-synced content.
REVALIDATE_SECRET=
